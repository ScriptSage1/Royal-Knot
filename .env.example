# Copy to .env and adjust. Never commit a real .env file.

# Server
PORT=3000
# development | production. Production turns on Secure cookies, HSTS and
# refuses to seed demo accounts unless ALLOW_DEMO_SEED=true.
NODE_ENV=development
# Set to true when the app is served over HTTPS (forced on in production).
COOKIE_SECURE=false
# Session lifetime in hours.
SESSION_TTL_HOURS=72

# Storage (paths are relative to the project folder)
DATABASE_PATH=data/royal-knot.db
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_KB=512

# Demo seed (development only). Leave blank to use the README's demo password.
DEMO_PASSWORD=
# Seed demo data automatically when the database is empty.
AUTO_SEED_DEMO=true
ALLOW_DEMO_SEED=false

# Optional: the locally installed Claude Code CLI drafts the requirements
# document and planner checklist. It runs on the server only and uses the
# subscription the CLI is signed in with (run `claude` once and sign in).
# ANTHROPIC_API_KEY is removed from its environment so it never switches to
# API billing. Leave blank to disable; planners then draft manually from a
# template. Example: claude  (or a full path to claude.exe)
CLAUDE_CLI_COMMAND=
CLAUDE_CLI_MODEL=haiku
# Effort for the first attempt, and for one retry when the output is invalid
# or reports significant conflicts. Leave a value blank to omit the --effort
# flag (for a model that does not support it) or to disable the retry.
CLAUDE_CLI_EFFORT=medium
CLAUDE_CLI_RETRY_EFFORT=high
CLAUDE_CLI_TIMEOUT_MS=120000

# Optional: a standing meeting room link offered when a planner confirms a
# consultation (e.g. the studio's video room). Planners can always paste a
# link per appointment instead.
DEFAULT_MEETING_LINK=
