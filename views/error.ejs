<%- include('partials/head') %>
<body class="site site-auth">
  <main class="auth">
    <%- include('partials/logo', { tone: 'on-dark', href: '/', cls: 'auth-brand' }) %>
    <section class="auth-card rk-folio rk-clasp" aria-labelledby="err-h">
      <p class="site-eyebrow"><%= status %></p>
      <h1 id="err-h" class="auth-title"><%= status === 404 ? 'That page isn’t here' : status === 403 ? 'This isn’t available to you' : 'Something went wrong' %></h1>
      <p class="auth-lede"><%= message %></p>
      <p><a class="btn" href="<%= back %>"><%= back === '/' ? 'Go to the home page' : 'Back to your space' %></a></p>
    </section>
  </main>
</body>
</html>
