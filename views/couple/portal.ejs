<%- include('../partials/head') %>
<body class="couple" data-view="home">
  <%- include('../partials/garden') %>
  <a class="skip-link" href="#cp-main">Skip to content</a>

  <header class="cx-bar">
    <%- include('../partials/logo', { tone: 'on-dark', href: '#home', label: 'The Royal Knot — your planning space home', cls: 'cx-brand' }) %>
    <div class="cx-bar-side">
      <span class="cx-planner" id="cx-planner"></span>
      <a class="cx-account" href="#account" aria-label="Your account and partner invite">
        <span class="cx-account-dot" aria-hidden="true"><%= user.name.slice(0, 1).toUpperCase() %></span>
        <span class="cx-account-name"><%= user.name %></span>
      </a>
    </div>
  </header>

  <main class="cx-main" id="cp-main" tabindex="-1">
    <div id="cp-view"><p class="cx-loading">Preparing your garden…</p></div>
  </main>

  <div class="toast-region" id="toast-region" aria-live="polite" aria-atomic="false"></div>
  <script type="module" src="/static/js/pages/couple.js"></script>
</body>
</html>
