    <nav class="ag-nav ag-nav-sub" aria-labelledby="ag-section-label"></nav>
  </div>
  <p class="ag-internal-flag">
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"/><path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7"/></svg>
    Internal workspace · not visible to couples
  </p>
</aside>
