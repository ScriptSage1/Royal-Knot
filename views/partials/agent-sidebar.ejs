<% const isVendor = iface === 'vendor'; const homeUrl = isVendor ? '/vendor' : '/agent/weddings'; %>
<header class="ag-topbar">
  <%- include('logo', { tone: 'on-dark', href: homeUrl, label: 'The Royal Knot — ' + (isVendor ? 'vendor requests' : 'weddings'), sub: isVendor ? 'Vendor portal' : 'Planning studio', cls: 'ag-brand' }) %>
  <button class="ag-menu-btn" type="button" aria-expanded="false" aria-controls="ag-sidebar">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>Menu
  </button>
</header>
<div class="ag-backdrop" hidden></div>
<aside class="ag-sidebar" id="ag-sidebar" aria-label="<%= isVendor ? 'Vendor' : 'Agency' %> navigation">
  <div class="ag-sidebar-head">
    <%- include('logo', { tone: 'on-dark', href: homeUrl, label: 'The Royal Knot — ' + (isVendor ? 'vendor requests' : 'weddings'), sub: isVendor ? 'Vendor portal' : 'Planning studio', cls: 'ag-brand' }) %>
    <button class="ag-close-btn" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav class="ag-nav" aria-label="Primary">
    <a href="<%= homeUrl %>" aria-current="page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg><%= isVendor ? 'Requests' : 'Weddings' %></a>
  </nav>
  <div class="ag-nav-group" id="ag-section-nav" hidden>
    <p class="ag-nav-label" id="ag-section-label">This wedding</p>
    <nav class="ag-nav ag-nav-sub" aria-labelledby="ag-section-label"></nav>
  </div>
  <div class="ag-account">
    <p class="ag-internal-flag">
      <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"/><path d="M5.5 7V5.2a2.5 2.5 0 0 1 5 0V7"/></svg>
      <%= isVendor ? 'Vendor access · your requests only' : 'Agency only' %>
    </p>
    <p class="ag-user"><%= user.name %></p>
    <form method="post" action="/logout"><input type="hidden" name="area" value="<%= isVendor ? 'vendor' : 'planner' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ag-signout" type="submit">Sign out</button></form>
  </div>
</aside>
