<header class="ag-topbar">
  <a class="ag-brand" href="/agent/weddings">
    <span class="ag-brand-mark" aria-hidden="true">RK</span>
    <span><strong>The Royal Knot</strong><small>Planning studio</small></span>
  </a>
  <button class="ag-menu-btn" type="button" aria-expanded="false" aria-controls="ag-sidebar">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>Menu
  </button>
</header>
<div class="ag-backdrop" hidden></div>
<aside class="ag-sidebar" id="ag-sidebar" aria-label="Agency navigation">
  <div class="ag-sidebar-head">
    <a class="ag-brand" href="/agent/weddings">
      <span class="ag-brand-mark" aria-hidden="true">RK</span>
      <span><strong>The Royal Knot</strong><small>Planning studio</small></span>
    </a>
    <button class="ag-close-btn" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <nav class="ag-nav" aria-label="Primary">
    <a href="/agent/weddings" <%= nav === 'weddings' ? 'aria-current=page' : '' %>>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Weddings</a>
    <a href="/agent/season" <%= nav === 'season' ? 'aria-current=page' : '' %>>
