<%- include('partials/head') %>
<body class="hub">
  <main class="hub-main">
    <p class="eyebrow">The Royal Knot</p>
    <h1 class="display"><%= typeof notFound !== 'undefined' ? 'That page isn’t here' : 'Developer preview' %></h1>
    <p class="lede">Preview only · no sign-in, saving, sending or payments.</p>
    <div class="hub-grid">
      <a class="hub-card" href="/couple">
        <span class="hub-tag">Client-facing</span>
        <h2>Couple portal</h2>
        <p>Share your story, meet a planner, compare vendors and follow the plan.</p>
        <span class="hub-go">Open couple portal →</span>
      </a>
      <a class="hub-card hub-card-dark" href="/agent/weddings">
        <span class="hub-tag">Internal</span>
        <h2>Agent workspace</h2>
        <p>Manage a wedding from consultation to closeout.</p>
        <span class="hub-go">Open agent workspace →</span>
      </a>
    </div>
    <p class="hub-foot">Demo: add <code>?stage=0–9</code> to preview progress. Add <code>?dev=1</code> for controls.</p>
  </main>
</body>
</html>
